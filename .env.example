# Copy to .env and fill in. NEVER commit .env.
# NEVER prefix secrets with VITE_ — anything VITE_* is bundled into the browser.

PORT=3000

# Scan AI (Zachary). true = return fixtures instead of calling Gemini.
USE_MOCK_AI=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Tried in order when the main model is overloaded, slow, out of quota or retired.
GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-flash-latest
# Last resort, different company (https://console.groq.com/keys). Vision models only.
GROQ_API_KEY=
GROQ_MODELS=qwen/qwen3.8-27b

# "Ask about my medicine" chatbot (Zachary). Text only, so it uses its own models and gets its own free quota.
# Gemini models only (Gemma rejects systemInstruction). Check limits per model at https://aistudio.google.com/rate-limit
GEMINI_CHAT_MODELS=gemini-flash-lite-latest,gemini-2.5-flash-lite
# Optional Groq text models as a last resort (https://console.groq.com/docs/rate-limits)
GROQ_CHAT_MODELS=
CHAT_RATE_LIMIT=10
AI_CHAT_DAILY_CAP=500
# Read-aloud for devices with no voice for the language (Gemini speech; uses GEMINI_API_KEY). First model, then fallbacks.
GEMINI_TTS_MODELS=gemini-3.8-flash-lite-tts,gemini-3.8-flash-tts
GEMINI_TTS_VOICE=Kore
TTS_RATE_LIMIT=12
AI_TTS_DAILY_CAP=300

# Rate limiting for real image scans (sample scans are never limited)
SCAN_RATE_LIMIT=10
SCAN_RATE_WINDOW_MIN=10
AI_DAILY_CAP=200

# Database + auth (Sheen Hern)
# For local development without Atlas, run pnpm server:local (see docs/auth.md).
# Atlas / pnpm server requires a random JWT_SECRET of at least 32 bytes.
# Shared development database: use /wad2_dev in the Atlas URI (see docs/atlas.md).
# Each teammate uses their own database credentials; JWT_SECRET is shared privately.
MONGODB_URI=
JWT_SECRET=

# Google Calendar (Zachary). OAuth "Web application" client; redirect must match one listed in Google Cloud exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/api/google/callback
# Encrypts users' Google refresh tokens in MongoDB: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GOOGLE_TOKEN_KEY=
