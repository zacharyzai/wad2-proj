{
  "name": "ah-ma-ah-gong-can",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node --watch --env-file-if-exists=.env server/index.js",
    "start": "node --env-file-if-exists=.env server/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:unit": "vitest run src",
    "test:api": "vitest run server",
    "test:e2e": "playwright test",
    "test:e2e:simple": "playwright test -c playwright.simple.config.js",
    "try:scan": "node --env-file-if-exists=.env server/scripts/try-scan.js",
    "server:local": "node --env-file-if-exists=.env server/scripts/local-server.js",
    "db:check": "node --env-file-if-exists=.env server/scripts/check-database.js",
    "atlas:configure": "node server/scripts/configure-atlas.js"
  },
  "engines": {
    "node": ">=22.9.0"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "axios": "^1.21.0",
    "bootstrap": "^5.3.8",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.2",
    "pdfjs-dist": "^6.4.299",
    "pinia": "^4.1.0",
    "tesseract.js": "^7.0.0",
    "vue": "^3.5.43",
    "vue-i18n": "^11.4.14",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "jsdom": "^30.1.3",
    "mongodb-memory-server": "^11.3.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
